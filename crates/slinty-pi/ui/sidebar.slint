import { Button, ComboBox, ListView, LineEdit, Palette } from "std-widgets.slint";

export struct SessionRow {
    path: string,
    title: string,
    relative-time: string,
    active: bool,
    cost: string,
}

component DeleteButton inherits Rectangle {
    callback delete-requested();
    property <bool> confirming: false;

    width: confirming ? 54px : 20px;
    height: 20px;
    border-radius: 5px;
    background: touch.has-hover ? Palette.alternate-background.darker(10%) : transparent;
    animate width { duration: 120ms; }

    Text {
        text: confirming ? "sure?" : "×";
        font-size: confirming ? 10px : 14px;
        color: confirming ? #d35454 : Palette.foreground.transparentize(0.4);
    }
    touch := TouchArea {
        clicked => {
            if (root.confirming) {
                root.delete-requested();
                root.confirming = false;
            } else {
                root.confirming = true;
                reset.running = true;
            }
        }
    }
    reset := Timer {
        interval: 2500ms;
        running: false;
        triggered => {
            root.confirming = false;
            self.running = false;
        }
    }
}

component RenameButton inherits Rectangle {
    callback clicked();

    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: touch.has-hover ? Palette.alternate-background.darker(10%) : transparent;

    Text {
        text: "✎";
        font-size: 11px;
        color: Palette.foreground.transparentize(0.4);
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Pulsing dot marking the sidebar row of the one session that can ever be
// "live" in v1's single-child process model (see PRODUCT_PLAN's process
// model note): the active session while it's streaming a turn.
component LiveDot inherits Rectangle {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background: Palette.accent-background;
    opacity: 0.35 + 0.65 * Math.abs(Math.sin((animation-tick() / 900ms) * 360deg));
}

component SessionRowItem inherits Rectangle {
    in property <SessionRow> entry;
    in property <bool> live: false;
    property <bool> renaming: false;
    callback resume();
    callback delete();
    // Only ever fired for the active row: `set_session_name` (like `clone`)
    // has no path argument, it renames whatever session the single live
    // child currently has open.
    callback rename(string);

    height: 38px;
    border-radius: 6px;
    background: entry.active ? Palette.accent-background.transparentize(0.85)
        : touch.has-hover ? Palette.alternate-background : transparent;

    touch := TouchArea {
        clicked => { if (!root.renaming) { root.resume(); } }
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 6px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                if root.live: LiveDot { }
                if !root.renaming: Text {
                    text: entry.title == "" ? "(untitled)" : entry.title;
                    font-size: 12.5px;
                    font-weight: entry.active ? 700 : 400;
                    color: Palette.foreground;
                    overflow: elide;
                }
                if root.renaming: LineEdit {
                    text: entry.title;
                    font-size: 12.5px;
                    horizontal-stretch: 1;
                    init => { self.select-all(); self.focus(); }
                    accepted(text) => {
                        root.renaming = false;
                        if (text != "" && text != entry.title) {
                            root.rename(text);
                        }
                    }
                    changed has-focus => {
                        if (!self.has-focus) {
                            root.renaming = false;
                        }
                    }
                }
                if entry.active && !root.renaming && touch.has-hover: RenameButton {
                    clicked => { root.renaming = true; }
                }
            }
            HorizontalLayout {
                spacing: 4px;
                Text {
                    text: entry.relative-time;
                    font-size: 10px;
                    color: Palette.foreground.transparentize(0.5);
                }
                if entry.cost != "": Text {
                    text: "· " + entry.cost;
                    font-size: 10px;
                    color: Palette.foreground.transparentize(0.5);
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if touch.has-hover || entry.active: DeleteButton {
            delete-requested => { root.delete(); }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[string]> project-list: [];
    in property <[string]> project-paths: [];
    in-out property <int> project-index: -1;
    in property <string> current-project-name: "";
    in property <[SessionRow]> sessions: [];
    in property <bool> streaming: false;

    callback project-selected(string);
    callback new-session();
    callback resume-session(string);
    callback delete-session(string);
    callback rename-session(string);
    callback search-edited(string);

    width: 240px;
    background: Palette.alternate-background.transparentize(0.5);

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        Text {
            text: root.current-project-name;
            font-size: 13px;
            font-weight: 700;
            color: Palette.foreground;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 4px;
            ComboBox {
                model: root.project-list;
                current-index <=> root.project-index;
                selected => {
                    if (self.current-index >= 0 && self.current-index < root.project-paths.length) {
                        root.project-selected(root.project-paths[self.current-index]);
                    }
                }
            }
            Button {
                text: "+";
                width: 28px;
                clicked => { root.new-session(); }
            }
        }

        LineEdit {
            placeholder-text: "Search sessions…";
            edited(text) => { root.search-edited(text); }
        }

        Rectangle {
            vertical-stretch: 1;
            ListView {
                for entry in root.sessions: SessionRowItem {
                    entry: entry;
                    live: entry.active && root.streaming;
                    resume => { root.resume-session(entry.path); }
                    delete => { root.delete-session(entry.path); }
                    rename(name) => { root.rename-session(name); }
                }
            }
            if root.sessions.length == 0: Text {
                text: "No sessions yet.";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.5);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
