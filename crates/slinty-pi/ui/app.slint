import { Button, ComboBox, ListView, Palette, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Sidebar, SessionRow } from "sidebar.slint";
import { TreeOverlay, TreeRow } from "tree.slint";
import { CommandPalette, PaletteRow } from "palette.slint";
import { ModelsOverlay, CachedModelRow, RouterModelRow, HfSearchOverlay, HfResultRow } from "models.slint";

export struct TableCell {
    text: string,
    header: bool,
    // Column stretch weight (same for every cell of a column), precomputed
    // in Rust from the column's longest cell.
    weight: float,
}

export struct TableRowCells {
    cells: [TableCell],
}

export struct ColoredSpan {
    text: string,
    color: color,
}

export struct CodeLine {
    spans: [ColoredSpan],
}

// One transcript row. Assistant messages are segmented (prose / heading /
// code / quote / rule / table) into several rows; user/thinking/tool/info/
// error are single rows.
export struct Row {
    kind: string,        // "user"|"prose"|"heading"|"code"|"quote"|"rule"|"table"|"thinking"|"tool"|"info"|"error"
    styled: styled-text, // prose content
    text: string,        // user text / heading text / tool summary / thinking text / raw code (copy source)
    lang: string,        // code language label
    level: int,          // heading level
    expanded: bool,      // thinking & tool rows
    expanded-overridden: bool, // tool rows: user has explicitly toggled
                               // expansion, so density's force-expand should
                               // no longer apply
    detail: string,      // tool expanded detail
    running: bool,       // busy indicator on thinking/tool rows
    elapsed: string,     // tool elapsed label
    first: bool,         // first row of a message: extra top spacing
    raw: string,         // full source markdown of the enclosing message/text
                         // block, shared by every row segmented out of it;
                         // "" where no group copy is offered
    code-lines: [CodeLine],       // "code" rows: per-line, per-span highlighted content
    table-rows: [TableRowCells],  // "table" rows: row-major cells, header row first
    table-pref-width: length,     // "table" rows: estimated natural width
}

export struct QueueItem {
    kind: string, // "steer" | "follow-up"
    text: string,
}

global Style {
    out property <length> radius: 9px;
    out property <string> mono-font: "Menlo";
    out property <color> dim: Palette.foreground.transparentize(0.45);
    out property <color> faint: Palette.foreground.transparentize(0.65);
    out property <brush> card: Palette.control-background;
    out property <brush> code-bg: Palette.color-scheme == ColorScheme.dark
        ? #16181d : #f6f7f9;
    out property <brush> hairline: Palette.border.transparentize(0.5);

    // density: 0 = Verbose, 1 = Normal, 2 = Summary. Errors always show;
    // Summary additionally hides thinking/tool/info rows.
    public pure function row-visible(density: int, kind: string) -> bool {
        if (kind == "error") {
            return true;
        }
        if (density == 2) {
            return kind == "user" || kind == "prose" || kind == "heading" || kind == "code"
                || kind == "quote" || kind == "rule" || kind == "table";
        }
        return true;
    }

    // Vertical gap above a row: message groups get the largest, headings a
    // section-sized one, content blocks a paragraph-sized one, and
    // meta rows (thinking/tool/info) stay tight.
    public pure function row-gap(kind: string, first: bool) -> length {
        if (first) {
            return 14px;
        }
        if (kind == "heading") {
            return 12px;
        }
        if (kind == "prose" || kind == "code" || kind == "table" || kind == "quote" || kind == "rule") {
            return 8px;
        }
        return 5px;
    }
}

component Dots inherits Text {
    // Animated "thinking" ellipsis. Stepped by a Timer, not animation-tick():
    // an animation-tick() binding marks the window dirty every frame, which
    // kept the whole (fully redrawn) scene rendering at display refresh rate
    // for a label with four discrete states.
    property <int> n: 0;
    text: n == 0 ? "" : n == 1 ? "·" : n == 2 ? "··" : "···";
    Timer {
        interval: 350ms;
        triggered => { root.n = Math.mod(root.n + 1, 4); }
    }
    color: Style.dim;
    font-size: 13px;
    min-width: 14px;
}

component CopyButton inherits Rectangle {
    in property <string> payload;
    callback copy-requested(string);
    property <bool> copied: false;

    width: 34px;
    height: 20px;
    border-radius: 5px;
    background: touch.has-hover ? Palette.alternate-background : transparent;

    touch := TouchArea {
        clicked => {
            root.copy-requested(root.payload);
            root.copied = true;
            reset.running = true;
        }
    }
    Text {
        text: root.copied ? "✓" : "copy";
        font-size: 10px;
        color: root.copied ? Palette.accent-background : Style.dim;
    }
    reset := Timer {
        interval: 1400ms;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }
}

component UsageRing inherits Rectangle {
    // Context-window usage, 0..100.
    in property <float> percent: 0;
    property <float> p: Math.max(0.01, Math.min(0.999, percent / 100));
    width: 16px;
    height: 16px;

    Path {
        // Track.
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Style.hairline;
        stroke-width: 3px;
        MoveTo { x: 12; y: 2; }
        ArcTo { x: 11.99; y: 2; radius-x: 10; radius-y: 10; large-arc: true; sweep: true; }
    }
    Path {
        // Usage arc, sweeping clockwise from 12 o'clock.
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: percent > 85 ? #d35454 : Palette.accent-background;
        stroke-width: 3px;
        MoveTo { x: 12; y: 2; }
        ArcTo {
            x: 12 + 10 * Math.sin(p * 360deg);
            y: 12 - 10 * Math.cos(p * 360deg);
            radius-x: 10;
            radius-y: 10;
            large-arc: p > 0.5;
            sweep: true;
        }
    }
}

component UserRow inherits HorizontalLayout {
    in property <Row> entry;
    // Stretch spacer caps the bubble short of the full transcript width
    // (width bindings against the ListView would loop; see project notes).
    Rectangle { horizontal-stretch: 1; min-width: 60px; }
    Rectangle {
        horizontal-stretch: 0;
        background: Palette.accent-background.transparentize(0.88);
        border-radius: Style.radius;
        HorizontalLayout {
            padding: 11px;
            Text {
                text: entry.text;
                wrap: word-wrap;
                font-size: 14px;
                color: Palette.foreground;
            }
        }
    }
    Rectangle { width: 2px; }
}

component ProseRow inherits HorizontalLayout {
    in property <Row> entry;
    callback open-link(string);
    callback copy-requested(string);
    padding-right: 12px;
    StyledText {
        text: entry.styled;
        default-font-size: 14px;
        default-color: Palette.foreground;
        link-color: Palette.accent-background;
        link-clicked(l) => { root.open-link(l); }
    }
    if entry.first && entry.raw != "": Rectangle { horizontal-stretch: 1; min-width: 8px; }
    if entry.first && entry.raw != "": CopyButton {
        payload: entry.raw;
        copy-requested(t) => { root.copy-requested(t); }
    }
}

component HeadingRow inherits HorizontalLayout {
    in property <Row> entry;
    callback copy-requested(string);
    Text {
        text: entry.text;
        wrap: word-wrap;
        font-size: entry.level == 1 ? 20px
            : entry.level == 2 ? 17.5px
            : entry.level == 3 ? 15.5px
            : 14px;
        font-weight: 700;
        // h4+ is body-sized; set it apart from bold prose by dimming.
        color: entry.level >= 4 ? Palette.foreground.transparentize(0.2) : Palette.foreground;
    }
    if entry.first && entry.raw != "": Rectangle { horizontal-stretch: 1; min-width: 8px; }
    if entry.first && entry.raw != "": CopyButton {
        payload: entry.raw;
        copy-requested(t) => { root.copy-requested(t); }
    }
}

component QuoteRow inherits HorizontalLayout {
    in property <Row> entry;
    callback open-link(string);
    callback copy-requested(string);
    padding-right: 12px;
    spacing: 10px;
    Rectangle {
        width: 3px;
        border-radius: 1.5px;
        background: Palette.foreground.transparentize(0.75);
    }
    StyledText {
        text: entry.styled;
        default-font-size: 14px;
        default-color: Style.dim;
        link-color: Palette.accent-background;
        link-clicked(l) => { root.open-link(l); }
    }
    if entry.first && entry.raw != "": Rectangle { horizontal-stretch: 1; min-width: 8px; }
    if entry.first && entry.raw != "": CopyButton {
        payload: entry.raw;
        copy-requested(t) => { root.copy-requested(t); }
    }
}

component RuleRow inherits HorizontalLayout {
    padding-top: 5px;
    padding-bottom: 5px;
    padding-right: 12px;
    Rectangle {
        height: 1px;
        background: Style.hairline;
    }
}

component CodeRow inherits Rectangle {
    in property <Row> entry;
    in property <color> bg: #2b303b;
    callback copy-requested(string);

    background: bg;
    border-radius: Style.radius;
    border-width: 1px;
    border-color: Style.hairline;
    clip: true;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 8px;
            padding-top: 6px;
            height: 28px;
            Text {
                text: entry.lang == "" ? "code" : entry.lang;
                font-size: 10px;
                font-family: Style.mono-font;
                color: Style.faint;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            CopyButton {
                payload: entry.text;
                copy-requested(t) => { root.copy-requested(t); }
            }
        }
        // Long lines pan horizontally instead of clipping at the card edge.
        // The Flickable has no intrinsic size, so its height comes from the
        // line stack's preferred height (content-driven, no ancestor-width
        // binding — safe inside the ListView).
        Flickable {
            height: lines.preferred-height;
            viewport-width: max(self.width, lines.preferred-width);
            lines := VerticalLayout {
                padding: 12px;
                padding-top: 2px;
                alignment: start;
                for line in entry.code-lines: HorizontalLayout {
                    alignment: start;
                    // Keeps blank lines at full line-height instead of collapsing.
                    if line.spans.length == 0: Text {
                        text: " ";
                        font-family: Style.mono-font;
                        font-size: 12.5px;
                    }
                    for span in line.spans: Text {
                        text: span.text;
                        color: span.color;
                        font-family: Style.mono-font;
                        font-size: 12.5px;
                    }
                }
            }
        }
    }
}

// Row-major so a wrapping cell grows its whole row (cells in a
// HorizontalLayout share the row's height) — with column-major stacks the
// columns drift out of alignment and overflow clips at the card edge.
component TableBlock inherits Rectangle {
    in property <[TableRowCells]> rows;

    background: Style.hairline;
    border-radius: Style.radius;
    border-width: 1px;
    border-color: Style.hairline;
    clip: true;

    VerticalLayout {
        padding: 1px;
        spacing: 1px;
        for row in rows: HorizontalLayout {
            spacing: 1px;
            for cell in row.cells: Rectangle {
                // Width comes from the column weight alone (preferred 0), so
                // every row computes identical column boundaries — content-
                // driven preferred widths would leave the grid lines jagged.
                preferred-width: 0px;
                min-width: 24px;
                horizontal-stretch: cell.weight;
                background: cell.header ? Style.card.darker(4%) : Style.card;
                VerticalLayout {
                    padding: 8px;
                    Text {
                        text: cell.text;
                        font-size: 12.5px;
                        font-weight: cell.header ? 700 : 400;
                        color: Palette.foreground;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component ThinkingRow inherits VerticalLayout {
    in-out property <Row> entry;
    spacing: 4px;
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Rectangle {
            height: 20px;
            t := Text {
                text: entry.expanded ? "▾ thinking" : "▸ thinking";
                font-size: 12px;
                color: Style.dim;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { entry.expanded = !entry.expanded; }
            }
        }
        if entry.running: Dots { }
    }
    if entry.expanded: HorizontalLayout {
        padding-left: 14px;
        padding-right: 48px;
        Text {
            text: entry.text;
            wrap: word-wrap;
            font-size: 12.5px;
            font-italic: true;
            color: Style.dim;
        }
    }
}

component ToolRow inherits VerticalLayout {
    in-out property <Row> entry;
    in property <bool> force-expanded: false;
    // Once the user has explicitly toggled a row, their choice always wins;
    // until then, density's force-expand (e.g. verbose mode) sets the default.
    property <bool> effective-expanded: entry.expanded-overridden ? entry.expanded : (entry.expanded || force-expanded);
    spacing: 4px;
    HorizontalLayout {
        alignment: start;
        spacing: 6px;
        chip := Rectangle {
            background: Style.card;
            border-radius: 6px;
            border-width: 1px;
            border-color: Style.hairline;
            HorizontalLayout {
                padding: 6px;
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                Text {
                    text: entry.text;
                    font-size: 12px;
                    font-family: Style.mono-font;
                    color: Palette.foreground.transparentize(0.2);
                    overflow: elide;
                    max-width: 560px;
                }
                if entry.elapsed != "": Text {
                    text: entry.elapsed;
                    font-size: 11px;
                    color: Style.faint;
                }
            }
            TouchArea {
                clicked => {
                    entry.expanded = !effective-expanded;
                    entry.expanded-overridden = true;
                }
            }
        }
        if entry.running: Dots { }
    }
    if effective-expanded && entry.detail != "": Rectangle {
        background: Style.code-bg;
        border-radius: 6px;
        HorizontalLayout {
            padding: 10px;
            Text {
                text: entry.detail;
                wrap: word-wrap;
                font-size: 11.5px;
                font-family: Style.mono-font;
                color: Style.dim;
            }
        }
    }
}

component NoteRow inherits HorizontalLayout {
    in property <Row> entry;
    alignment: start;
    Text {
        text: entry.text;
        wrap: word-wrap;
        font-size: 12px;
        color: entry.kind == "error" ? #d35454 : Style.dim;
    }
}

export component AppWindow inherits Window {
    title: "slinty-pi";
    preferred-width: 940px;
    preferred-height: 760px;
    min-width: 520px;
    min-height: 420px;
    background: Palette.background;

    in property <[Row]> transcript: [];
    in property <[QueueItem]> queue: [];
    in property <[string]> model-list: [];
    in-out property <int> model-index: -1;
    in property <[string]> thinking-list: [];
    in-out property <int> thinking-index: -1;
    in property <bool> streaming: false;
    in property <string> status-text: "";
    // Status-bar server dot: 0 = hidden (cloud model), 1 = local server
    // serving the current model, 2 = local server down (needs attention),
    // 3 = server up but serving a different model (requests would 404).
    // Click restarts a dead managed rapid-mlx server, or opens the models
    // panel.
    in property <int> server-dot: 0;
    in property <float> context-percent: 0;
    in property <int> composer-lines: 1;
    // File names of images queued for the next send (attach button).
    in property <[string]> pending-attachments: [];
    // Set from Rust to the syntect theme's own background color, so
    // highlighted spans keep the contrast they were designed with.
    in property <color> code-background: #2b303b;
    out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
    // Fires when the effective color scheme resolves or flips — including
    // the first resolution right after the window is shown, which the
    // startup seed can't see (winit only reports the real theme once the
    // window exists).
    changed dark-mode => { root.scheme-changed(root.dark-mode); }

    in-out property <bool> sidebar-visible: true;
    in property <[string]> project-list: [];
    in property <[string]> project-paths: [];
    in-out property <int> project-index: -1;
    in property <string> current-project-name: "";
    in property <[SessionRow]> sidebar-sessions: [];

    in-out property <bool> tree-visible: false;
    in property <[TreeRow]> tree-rows: [];

    in-out property <bool> models-visible: false;
    in property <string> rapid-mlx-version: "";
    in property <string> rapid-mlx-running: "";
    in property <[CachedModelRow]> rapid-mlx-cached: [];
    in property <int> rapid-mlx-catalog-count: 0;
    in property <string> router-status: "";
    in property <string> router-url: "";
    in property <[RouterModelRow]> router-models: [];
    in property <bool> ollama-detected: false;
    in property <string> ollama-summary: "";
    in property <int> ollama-model-count: 0;
    in property <[string]> auth-entries: [];

    in-out property <bool> hf-search-visible: false;
    in property <[HfResultRow]> hf-search-results: [];

    // 0 = Verbose, 1 = Normal, 2 = Summary. Set from Rust at startup from
    // the persisted state file; `density-changed` fires on every change
    // (including that initial set) so Rust can keep the file in sync.
    in-out property <int> density: 1;
    changed density => { root.density-changed(root.density); }

    in-out property <bool> palette-visible: false;
    in property <[PaletteRow]> palette-entries: [];
    changed palette-visible => {
        if (root.palette-visible) {
            root.open-palette();
        } else {
            // The palette's query field grabs focus on open; closing it
            // destroys that FocusScope along with the focused element, so
            // without this the root scope has no focus path left to fire
            // capture-key-pressed on — every global shortcut would go dead
            // after the first palette use.
            root.focus-input();
        }
    }

    callback send(string);
    callback abort();
    callback copy-text(string);
    callback open-link(string);
    callback model-selected(int);
    callback thinking-selected(int);
    callback composer-edited(string);
    callback project-selected(string);
    callback new-session();
    callback resume-session(string);
    callback delete-session(string);
    callback rename-session(string);
    callback sidebar-search-edited(string);
    callback open-tree();
    callback fork-from(string);
    callback open-models();
    callback serve-rapid-mlx(string);
    callback load-router-model(string);
    callback unload-router-model(string);
    callback hf-search(string);
    callback download-hf-model(string);
    callback add-ollama-to-pi();
    callback save-api-key(string, string);
    callback density-changed(int);
    callback scheme-changed(bool);
    callback server-dot-clicked();
    callback open-palette();
    callback palette-query(string);
    callback palette-exec(string);
    callback attach-clicked();
    callback remove-attachment(int);

    public function scroll-to-end() {
        list.viewport-y = -max(0px, list.viewport-height - list.height);
    }
    public function focus-input() {
        input.focus();
    }
    public function cycle-density() {
        root.density = root.density >= 2 ? 0 : root.density + 1;
    }
    // Prefill the composer (used after a fork, which hands back the text of
    // the forked-from message instead of keeping it in context).
    public function set-composer-text(text: string) {
        input.text = text;
        root.composer-edited(text);
        input.focus();
    }
    // Insert an `@path` reference (non-image attachment), separated from
    // any existing text by a space.
    public function append-to-composer(text: string) {
        input.text = input.text == "" ? text : input.text + " " + text;
        root.composer-edited(input.text);
    }
    function submit() {
        if (input.text != "") {
            root.send(input.text);
            input.text = "";
            root.composer-edited("");
        }
    }

    HorizontalLayout {
        if root.sidebar-visible: Sidebar {
            project-list: root.project-list;
            project-paths: root.project-paths;
            project-index <=> root.project-index;
            current-project-name: root.current-project-name;
            sessions: root.sidebar-sessions;
            streaming: root.streaming;
            project-selected(path) => { root.project-selected(path); }
            new-session => { root.new-session(); }
            resume-session(path) => { root.resume-session(path); }
            delete-session(path) => { root.delete-session(path); }
            rename-session(name) => { root.rename-session(name); }
            search-edited(q) => { root.sidebar-search-edited(q); }
        }

    FocusScope {
        // Cmd+P opens the command palette (it closes itself via its own
        // internal FocusScope, since opening moves keyboard focus into its
        // subtree — outside this scope — so this handler can no longer
        // reach it once it's up; see palette.slint). Esc otherwise closes
        // the tree overlay if open, else aborts from anywhere (including
        // while the composer has focus). Cmd+B toggles the sidebar; Cmd+N
        // starts a new session; Cmd+T opens the tree; Cmd+M opens the models
        // panel; Ctrl+O cycles density.
        capture-key-pressed(event) => {
            if (event.modifiers.meta && event.text == "p") {
                root.palette-visible = true;
                return accept;
            }
            if (event.text == Key.Escape && root.tree-visible) {
                root.tree-visible = false;
                return accept;
            }
            if (event.text == Key.Escape && root.models-visible) {
                root.models-visible = false;
                return accept;
            }
            if (event.text == Key.Escape && root.streaming) {
                root.abort();
                return accept;
            }
            if (event.modifiers.meta && event.text == "b") {
                root.sidebar-visible = !root.sidebar-visible;
                return accept;
            }
            if (event.modifiers.meta && event.text == "n") {
                root.new-session();
                return accept;
            }
            if (event.modifiers.meta && event.text == "t") {
                root.open-tree();
                return accept;
            }
            if (event.modifiers.meta && event.text == "m") {
                root.open-models();
                return accept;
            }
            if (event.modifiers.control && event.text == "o") {
                root.cycle-density();
                return accept;
            }
            reject
        }

        VerticalBox {
            spacing: 6px;

            Rectangle {
                vertical-stretch: 1;

                list := ListView {
                    for entry in transcript: VerticalLayout {
                        property <bool> row-shown: Style.row-visible(root.density, entry.kind);
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: row-shown ? Style.row-gap(entry.kind, entry.first) : 0px;

                        if row-shown && entry.kind == "user": UserRow { entry: entry; }
                        if row-shown && entry.kind == "prose": ProseRow {
                            entry: entry;
                            open-link(l) => { root.open-link(l); }
                            copy-requested(t) => { root.copy-text(t); }
                        }
                        if row-shown && entry.kind == "heading": HeadingRow {
                            entry: entry;
                            copy-requested(t) => { root.copy-text(t); }
                        }
                        if row-shown && entry.kind == "code": CodeRow {
                            entry: entry;
                            bg: root.code-background;
                            copy-requested(t) => { root.copy-text(t); }
                        }
                        if row-shown && entry.kind == "quote": QuoteRow {
                            entry: entry;
                            open-link(l) => { root.open-link(l); }
                            copy-requested(t) => { root.copy-text(t); }
                        }
                        if row-shown && entry.kind == "rule": RuleRow { }
                        // Explicit width (capped at the available span): a
                        // narrow table keeps its natural width instead of
                        // spanning the transcript, and the weight-only cells
                        // still get a real width to distribute.
                        if row-shown && entry.kind == "table": HorizontalLayout {
                            TableBlock {
                                horizontal-stretch: 0;
                                width: min(parent.width, entry.table-pref-width);
                                rows: entry.table-rows;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if row-shown && entry.kind == "thinking": ThinkingRow { entry <=> entry; }
                        if row-shown && entry.kind == "tool": ToolRow { entry <=> entry; force-expanded: root.density == 0; }
                        if row-shown && (entry.kind == "info" || entry.kind == "error"): NoteRow { entry: entry; }
                    }
                }

                if transcript.length == 0: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Ask pi anything.";
                        color: Style.faint;
                        font-size: 15px;
                        horizontal-alignment: center;
                    }
                }
            }

            if queue.length > 0: HorizontalBox {
                padding: 0;
                spacing: 6px;
                alignment: start;
                for item in queue: Rectangle {
                    background: Palette.accent-background.transparentize(0.9);
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 5px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        Text {
                            text: item.kind == "steer" ? "↪" : "»";
                            font-size: 11px;
                            color: Style.dim;
                        }
                        Text {
                            text: item.text;
                            font-size: 11px;
                            color: Palette.foreground;
                            overflow: elide;
                            max-width: 320px;
                        }
                    }
                }
            }

            if root.pending-attachments.length > 0: HorizontalLayout {
                spacing: 6px;
                padding-left: 4px;
                for name[i] in root.pending-attachments: Rectangle {
                    height: 22px;
                    border-radius: 5px;
                    background: Style.card;
                    border-width: 1px;
                    border-color: Style.hairline;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 4px;
                        Text {
                            text: name;
                            font-size: 11px;
                            color: Palette.foreground;
                            overflow: elide;
                            max-width: 140px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "✕";
                            font-size: 11px;
                            color: Style.faint;
                            vertical-alignment: center;
                            TouchArea { clicked => { root.remove-attachment(i); } }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            Rectangle {
                background: Style.card;
                border-radius: Style.radius;
                border-width: 1px;
                border-color: input.has-focus ? Palette.accent-background.transparentize(0.4) : Style.hairline;

                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;

                    composer-box := Rectangle {
                        height: min(6, max(1, root.composer-lines)) * 21px + 18px;

                        // The streaming steering hint fades out entirely a few
                        // seconds into a turn; it comes back on the next turn.
                        property <bool> hint-faded: false;
                        property <bool> is-streaming: root.streaming;
                        changed is-streaming => {
                            self.hint-faded = false;
                            hint-fade.running = self.is-streaming;
                        }
                        hint-fade := Timer {
                            interval: 6s;
                            running: false;
                            triggered => {
                                composer-box.hint-faded = true;
                                self.running = false;
                            }
                        }

                        input := TextEdit {
                            width: 100%;
                            height: 100%;
                            font-size: 14px;
                            wrap: word-wrap;
                            edited(text) => { root.composer-edited(text); }
                            key-pressed(event) => {
                                if (event.text == Key.Return && !event.modifiers.shift) {
                                    root.submit();
                                    return accept;
                                }
                                reject
                            }
                        }

                        // Custom placeholder: Fluent's built-in placeholder-text
                        // renders in a fixed, fairly bright text-secondary with no
                        // exposed color knob and no way to fade it out.
                        Text {
                            x: 13px;
                            y: 13px;
                            width: parent.width - 26px;
                            text: root.streaming
                                ? "Steer the agent — Enter queues, Esc stops…"
                                : "Message pi…  (Enter to send, Shift+Enter for newline)";
                            font-size: 14px;
                            color: Style.faint;
                            overflow: elide;
                            visible: input.text == "";
                            opacity: composer-box.hint-faded ? 0 : 1;
                            animate opacity { duration: 600ms; easing: ease-out; }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 4px;
                        padding-right: 2px;

                        UsageRing { percent: root.context-percent; }
                        if root.server-dot != 0: Rectangle {
                            width: 14px;
                            height: 20px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.server-dot == 2 ? #d35454
                                    : root.server-dot == 3 ? #e2a53f
                                    : #43a047;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.server-dot-clicked(); }
                            }
                        }
                        Text {
                            text: root.status-text;
                            font-size: 11px;
                            color: Style.faint;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            width: attach-label.width + 10px;
                            height: 20px;
                            border-radius: 5px;
                            background: attach-touch.has-hover ? Palette.alternate-background : transparent;
                            attach-label := Text {
                                text: "attach";
                                font-size: 11px;
                                color: Style.faint;
                                vertical-alignment: center;
                            }
                            attach-touch := TouchArea {
                                clicked => { root.attach-clicked(); }
                            }
                        }

                        Rectangle {
                            width: tree-label.width + 10px;
                            height: 20px;
                            border-radius: 5px;
                            background: tree-touch.has-hover ? Palette.alternate-background : transparent;
                            tree-label := Text {
                                text: "tree";
                                font-size: 11px;
                                color: Style.faint;
                                vertical-alignment: center;
                            }
                            tree-touch := TouchArea {
                                clicked => { root.open-tree(); }
                            }
                        }

                        Rectangle {
                            width: models-label.width + 10px;
                            height: 20px;
                            border-radius: 5px;
                            background: models-touch.has-hover ? Palette.alternate-background : transparent;
                            models-label := Text {
                                text: "models";
                                font-size: 11px;
                                color: Style.faint;
                                vertical-alignment: center;
                            }
                            models-touch := TouchArea {
                                clicked => { root.open-models(); }
                            }
                        }

                        Rectangle {
                            width: density-label.width + 10px;
                            height: 20px;
                            border-radius: 5px;
                            background: density-touch.has-hover ? Palette.alternate-background : transparent;
                            density-label := Text {
                                text: root.density == 0 ? "verbose" : root.density == 2 ? "summary" : "normal";
                                font-size: 11px;
                                color: Style.faint;
                                vertical-alignment: center;
                            }
                            density-touch := TouchArea {
                                clicked => { root.cycle-density(); }
                            }
                        }

                        if root.thinking-list.length > 1: ComboBox {
                            model: root.thinking-list;
                            current-index <=> root.thinking-index;
                            selected => { root.thinking-selected(self.current-index); }
                        }
                        ComboBox {
                            model: root.model-list;
                            current-index <=> root.model-index;
                            selected => { root.model-selected(self.current-index); }
                        }
                        if root.streaming: Button {
                            text: "Stop";
                            clicked => { root.abort(); }
                        }
                        if !root.streaming: Button {
                            text: "Send";
                            primary: true;
                            clicked => { root.submit(); }
                        }
                    }
                }
            }
        }
    }
    }

    if root.tree-visible: TreeOverlay {
        rows: root.tree-rows;
        close => { root.tree-visible = false; }
        fork-from(id) => {
            root.tree-visible = false;
            root.fork-from(id);
        }
    }

    if root.models-visible: ModelsOverlay {
        rapid-mlx-version: root.rapid-mlx-version;
        rapid-mlx-running: root.rapid-mlx-running;
        rapid-mlx-cached: root.rapid-mlx-cached;
        rapid-mlx-catalog-count: root.rapid-mlx-catalog-count;
        router-status: root.router-status;
        router-url: root.router-url;
        router-models: root.router-models;
        ollama-detected: root.ollama-detected;
        ollama-summary: root.ollama-summary;
        ollama-model-count: root.ollama-model-count;
        auth-entries: root.auth-entries;
        close => { root.models-visible = false; }
        serve-rapid-mlx(alias) => { root.serve-rapid-mlx(alias); }
        load-router-model(id) => { root.load-router-model(id); }
        unload-router-model(id) => { root.unload-router-model(id); }
        open-hf-search => { root.hf-search-visible = true; }
        add-ollama-to-pi => { root.add-ollama-to-pi(); }
        save-api-key(provider, key) => { root.save-api-key(provider, key); }
    }

    if root.hf-search-visible: HfSearchOverlay {
        results: root.hf-search-results;
        close => { root.hf-search-visible = false; }
        search(q) => { root.hf-search(q); }
        download(model) => { root.download-hf-model(model); }
        view-license(id) => { root.open-link("https://huggingface.co/" + id); }
    }

    if root.palette-visible: CommandPalette {
        entries: root.palette-entries;
        close => { root.palette-visible = false; }
        query-changed(q) => { root.palette-query(q); }
        exec(id) => {
            root.palette-visible = false;
            root.palette-exec(id);
        }
    }
}
