import { Button, ListView, LineEdit, Palette } from "std-widgets.slint";

export struct CachedModelRow {
    alias: string,
    hf-repo: string,
    size: string,
    fit-label: string,
}

export struct RouterModelRow {
    id: string,
    status: string,
    loaded: bool,
    busy: bool,
}

export struct HfResultRow {
    id: string,
    gated: bool,
    downloads: int,
    quants: [string],
}


component CachedModelItem inherits Rectangle {
    in property <CachedModelRow> entry;
    callback serve();

    height: 46px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.alternate-background.transparentize(0.3) : transparent;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        VerticalLayout {
            spacing: 2px;
            alignment: center;

            Text {
                text: entry.alias;
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: entry.hf-repo + " · " + entry.size;
                font-size: 10px;
                color: Palette.foreground.transparentize(0.4);
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            background: Palette.accent-background.transparentize(0.85);
            border-radius: 4px;
            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                Text {
                    text: entry.fit-label;
                    font-size: 10px;
                    color: Palette.accent-background;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            width: serve-label.width + 14px;
            height: 22px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Palette.border.transparentize(0.5);
            background: serve-touch.has-hover ? Palette.alternate-background.darker(10%) : transparent;

            serve-label := Text {
                text: "serve";
                font-size: 11px;
                color: Palette.foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            serve-touch := TouchArea {
                clicked => { root.serve(); }
            }
        }
    }

    touch := TouchArea {}
}

component RouterModelItem inherits Rectangle {
    in property <RouterModelRow> entry;
    callback load();
    callback unload();

    height: 40px;
    border-radius: 6px;
    background: touch.has-hover ? Palette.alternate-background.transparentize(0.3) : transparent;

    HorizontalLayout {
        padding: 8px;
        spacing: 8px;

        VerticalLayout {
            spacing: 2px;
            alignment: center;

            Text {
                text: entry.id;
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }
            Text {
                text: entry.status;
                font-size: 10px;
                color: entry.loaded ? Palette.accent-background : Palette.foreground.transparentize(0.4);
                overflow: elide;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if !entry.busy: Rectangle {
            width: action-label.width + 14px;
            height: 22px;
            border-radius: 5px;
            border-width: 1px;
            border-color: Palette.border.transparentize(0.5);
            background: action-touch.has-hover ? Palette.alternate-background.darker(10%) : transparent;

            action-label := Text {
                text: entry.loaded ? "unload" : "load";
                font-size: 11px;
                color: Palette.foreground;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            action-touch := TouchArea {
                clicked => {
                    if entry.loaded {
                        root.unload();
                    } else {
                        root.load();
                    }
                }
            }
        }
    }

    touch := TouchArea {}
}

export component ModelsOverlay inherits Rectangle {
    in property <string> rapid-mlx-version: "";
    in property <string> rapid-mlx-running: "";
    in property <[CachedModelRow]> rapid-mlx-cached: [];
    in property <int> rapid-mlx-catalog-count: 0;
    in property <string> router-status: "";
    in property <string> router-url: "";
    in property <[RouterModelRow]> router-models: [];
    in property <bool> ollama-detected: false;
    in property <string> ollama-summary: "";
    in property <int> ollama-model-count: 0;
    // Pre-formatted "provider · form" labels (never key material).
    in property <[string]> auth-entries: [];
    callback close();
    callback serve-rapid-mlx(string);
    callback load-router-model(string);
    callback unload-router-model(string);
    callback open-hf-search();
    callback add-ollama-to-pi();
    callback save-api-key(string, string);

    background: Palette.background.transparentize(0.1);

    TouchArea {
        // Click the scrim to dismiss.
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(560px, parent.width - 48px);
        height: min(640px, parent.height - 48px);
        background: Palette.background;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.border.transparentize(0.4);
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;

        // Swallow clicks so they don't fall through to the scrim.
        TouchArea {}

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: "Models";
                    font-size: 15px;
                    font-weight: 700;
                    color: Palette.foreground;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "close ✕";
                    font-size: 11px;
                    color: Palette.foreground.transparentize(0.4);
                    TouchArea { clicked => { root.close(); } }
                }
            }

            Rectangle {
                background: Palette.alternate-background.transparentize(0.5);
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;

                    Text {
                        text: "rapid-mlx";
                        font-size: 12px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    Text {
                        text: root.rapid-mlx-version == "" ? "not detected — install with `brew install rapid-mlx`" : root.rapid-mlx-version;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    Text {
                        text: root.rapid-mlx-running == "" ? "No server running" : root.rapid-mlx-running;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                }
            }

            Text {
                text: "Downloaded models";
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
            }

            ListView {
                height: 130px;
                for entry in root.rapid-mlx-cached: CachedModelItem {
                    entry: entry;
                    serve => { root.serve-rapid-mlx(entry.alias); }
                }
            }

            if root.rapid-mlx-cached.length == 0: Text {
                text: "No cached models yet — run `rapid-mlx pull <alias>` to download one.";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.5);
                wrap: word-wrap;
            }

            if root.rapid-mlx-catalog-count > 0: Text {
                text: root.rapid-mlx-catalog-count + " aliases available in the rapid-mlx catalog — download more with `rapid-mlx pull <alias>`.";
                font-size: 10px;
                color: Palette.foreground.transparentize(0.5);
                wrap: word-wrap;
            }

            Rectangle {
                background: Palette.alternate-background.transparentize(0.5);
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;

                    Text {
                        text: "llama.cpp router";
                        font-size: 12px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    HorizontalLayout {
                        Text {
                            text: root.router-status == "ready" ? "connected · " + root.router-url
                                : root.router-status == "loading" ? "starting up · " + root.router-url
                                : "not reachable at " + root.router-url;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(0.3);
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "download model…";
                            font-size: 11px;
                            color: Palette.accent-background;
                            TouchArea { clicked => { root.open-hf-search(); } }
                        }
                    }
                }
            }

            ListView {
                height: 110px;
                for entry in root.router-models: RouterModelItem {
                    entry: entry;
                    load => { root.load-router-model(entry.id); }
                    unload => { root.unload-router-model(entry.id); }
                }
            }

            if root.router-models.length == 0: Text {
                text: "No router models detected.";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.5);
                wrap: word-wrap;
            }

            Rectangle {
                background: Palette.alternate-background.transparentize(0.5);
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 3px;

                    HorizontalLayout {
                        Text {
                            text: "Ollama";
                            font-size: 12px;
                            font-weight: 600;
                            color: Palette.foreground;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.ollama-model-count > 0: Text {
                            text: "add all to pi";
                            font-size: 11px;
                            color: Palette.accent-background;
                            TouchArea { clicked => { root.add-ollama-to-pi(); } }
                        }
                    }
                    Text {
                        text: root.ollama-detected ? root.ollama-summary : "not detected";
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.3);
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                background: Palette.alternate-background.transparentize(0.5);
                border-radius: 6px;

                VerticalLayout {
                    padding: 8px;
                    spacing: 5px;

                    Text {
                        text: "Cloud API keys";
                        font-size: 12px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    for entry in root.auth-entries: Text {
                        text: entry;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.3);
                    }
                    if root.auth-entries.length == 0: Text {
                        text: "No credentials stored yet.";
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.5);
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        provider-input := LineEdit {
                            placeholder-text: "provider (e.g. anthropic)";
                            font-size: 11px;
                            horizontal-stretch: 0.6;
                        }
                        key-input := LineEdit {
                            placeholder-text: "API key";
                            input-type: password;
                            font-size: 11px;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Save";
                            enabled: provider-input.text != "" && key-input.text != "";
                            clicked => {
                                root.save-api-key(provider-input.text, key-input.text);
                                key-input.text = "";
                            }
                        }
                    }
                    Text {
                        text: "Stored in ~/.pi/agent/auth.json (0600). $ENV/!command and OAuth entries are read-only here — manage those in the file or via `pi /login`.";
                        font-size: 10px;
                        color: Palette.foreground.transparentize(0.5);
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

component HfResultItem inherits Rectangle {
    in property <HfResultRow> entry;
    callback download(string);
    callback view-license();

    height: entry.gated ? 88px : 72px;
    border-radius: 6px;
    background: Palette.alternate-background.transparentize(0.6);

    VerticalLayout {
        padding: 8px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 6px;
            Text {
                text: entry.id;
                font-size: 12px;
                font-weight: 600;
                color: Palette.foreground;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: entry.downloads + " downloads";
                font-size: 10px;
                color: Palette.foreground.transparentize(0.4);
            }
        }

        if entry.gated: Text {
            text: "⚠ gated — requires accepting a license on Hugging Face";
            font-size: 10px;
            color: #d9822b;
            wrap: word-wrap;
            TouchArea { clicked => { root.view-license(); } }
        }

        HorizontalLayout {
            spacing: 6px;
            for quant in entry.quants: Rectangle {
                width: quant-label.width + 12px;
                height: 20px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border.transparentize(0.5);
                background: quant-touch.has-hover ? Palette.alternate-background.darker(10%) : transparent;

                quant-label := Text {
                    text: quant;
                    font-size: 10px;
                    color: Palette.foreground;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                quant-touch := TouchArea {
                    clicked => { root.download(quant); }
                }
            }
        }
    }
}

export component HfSearchOverlay inherits Rectangle {
    in property <[HfResultRow]> results: [];
    callback close();
    callback search(string);
    callback download(string);
    callback view-license(string);

    background: Palette.background.transparentize(0.1);

    TouchArea {
        clicked => { root.close(); }
    }

    Rectangle {
        width: min(520px, parent.width - 48px);
        height: min(480px, parent.height - 48px);
        background: Palette.background;
        border-radius: 10px;
        border-width: 1px;
        border-color: Palette.border.transparentize(0.4);
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000055;

        TouchArea {}

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: "Download a model";
                    font-size: 15px;
                    font-weight: 700;
                    color: Palette.foreground;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "close ✕";
                    font-size: 11px;
                    color: Palette.foreground.transparentize(0.4);
                    TouchArea { clicked => { root.close(); } }
                }
            }

            query-box := LineEdit {
                placeholder-text: "Search Hugging Face for a GGUF model…";
                accepted(text) => { root.search(text); }
            }

            ListView {
                vertical-stretch: 1;
                for entry in root.results: HfResultItem {
                    entry: entry;
                    download(quant) => { root.download(entry.id + ":" + quant); }
                    view-license => { root.view-license(entry.id); }
                }
            }

            if root.results.length == 0: Text {
                text: "Search above (press Enter) to find GGUF models on Hugging Face.";
                font-size: 12px;
                color: Palette.foreground.transparentize(0.5);
                wrap: word-wrap;
            }
        }
    }
}
