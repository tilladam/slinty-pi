/target
**/*.rs.bk
.DS_Store

# macos/swifty-pi: UniFFI-generated Swift bindings and the xcframework built
# from pi-core-ffi — regenerated by scripts/build-rust.sh on every build,
# derived from a still-evolving Rust surface, never checked in.
/macos/swifty-pi/Generated/
/macos/swifty-pi/PiCoreFFI.xcframework/
# Xcode's own per-user build state, not project configuration.
/macos/swifty-pi/*.xcodeproj/xcuserdata/
/macos/swifty-pi/*.xcodeproj/project.xcworkspace/xcuserdata/

# Local Claude Code state — settings.local.json carries this machine's own
# absolute paths and permission grants, not something to share via the repo.
/.claude/
/.agents/
