/target
**/*.rs.bk
.DS_Store

# apps/pi-mac: UniFFI-generated Swift bindings and the xcframework built from
# pi-core-ffi — regenerated by scripts/build-rust.sh on every build, derived
# from a still-evolving Rust surface, never checked in.
/apps/pi-mac/Generated/
/apps/pi-mac/PiCoreFFI.xcframework/
# Xcode's own per-user build state, not project configuration.
/apps/pi-mac/*.xcodeproj/xcuserdata/
/apps/pi-mac/*.xcodeproj/project.xcworkspace/xcuserdata/

# Local Claude Code state — settings.local.json carries this machine's own
# absolute paths and permission grants, not something to share via the repo.
/.claude/
/.agents/
